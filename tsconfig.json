{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],

    "module": "ES2022",
    "moduleResolution": "Bundler",

    "types": [
      "@cloudflare/workers-types"
    ],

    "resolveJsonModule": true,

    "allowJs": false,
    "checkJs": false,

    "noEmit": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "worker-configuration.d.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "test",
    "tests"
  ]
}