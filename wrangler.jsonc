/**
 * Wrangler configuration for FLYTRIPVISA Cloudflare Worker
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "fly-trip-cz",

  "main": "src/index.ts",

  "compatibility_date": "2026-10-06",

  "observability": {
    "enabled": true
  }

  /*
   * Optional Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/
   *
   * "placement": {
   *   "mode": "smart"
   * }
   */

  /*
   * Environment variables
   * Use secrets for sensitive values.
   *
   * "vars": {
   *   "ENVIRONMENT": "production"
   * }
   */

  /*
   * Static assets
   * Enable this only if your Worker serves files from /public.
   *
   * "assets": {
   *   "directory": "./public/",
   *   "binding": "ASSETS"
   * }
   */

  /*
   * Service bindings
   *
   * "services": [
   *   {
   *     "binding": "MY_SERVICE",
   *     "service": "my-service"
   *   }
   * ]
   */
}